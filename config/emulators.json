{
  "_comment": "Per-platform emulator CLI launch templates. {romPath} is substituted with the absolute path to the launchable file resolved from catalog.json's launch.romFile. Adjust 'executable' to an absolute path if the binary isn't on PATH.",

  "nes": {
    "name": "RetroArch + FCEUmm",
    "executable": "retroarch",
    "argsTemplate": ["-L", "cores/fceumm_libretro.dll", "{romPath}"]
  },
  "snes": {
    "name": "RetroArch + Snes9x",
    "executable": "retroarch",
    "argsTemplate": ["-L", "cores/snes9x_libretro.dll", "{romPath}"]
  },
  "gb": {
    "name": "RetroArch + Gambatte",
    "executable": "retroarch",
    "argsTemplate": ["-L", "cores/gambatte_libretro.dll", "{romPath}"]
  },
  "gbc": {
    "name": "RetroArch + Gambatte",
    "executable": "retroarch",
    "argsTemplate": ["-L", "cores/gambatte_libretro.dll", "{romPath}"]
  },
  "gba": {
    "name": "RetroArch + mGBA",
    "executable": "retroarch",
    "argsTemplate": ["-L", "cores/mgba_libretro.dll", "{romPath}"]
  },
  "n64": {
    "name": "RetroArch + Mupen64Plus",
    "executable": "retroarch",
    "argsTemplate": ["-L", "cores/mupen64plus_next_libretro.dll", "{romPath}"]
  },
  "genesis": {
    "name": "RetroArch + Genesis Plus GX",
