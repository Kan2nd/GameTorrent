  "dreamcast": {
    "name": "RetroArch + Flycast",
    "executable": "retroarch",
    "argsTemplate": ["-L", "cores/flycast_libretro.dll", "{romPath}"]
  },
  "psp": {
    "name": "PPSSPP (standalone)",
    "executable": "PPSSPPSDL",
    "argsTemplate": ["{romPath}"]
  },
  "dos": {
    "name": "DOSBox",
    "executable": "dosbox",
    "argsTemplate": ["{romPath}", "-fullscreen", "-exit"]
  },
  "pc": {
    "name": "Direct executable launch",
    "executable": "{romPath}",
    "argsTemplate": []
  }
}
