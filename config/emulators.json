  },
  "psx": {
    "name": "RetroArch + Beetle PSX",
    "executable": "retroarch",
    "argsTemplate": ["-L", "cores/mednafen_psx_libretro.dll", "{romPath}"]
  },
  "nds": {
    "name": "RetroArch + melonDS",
    "executable": "retroarch",
    "argsTemplate": ["-L", "cores/melonds_libretro.dll", "{romPath}"]
  },
  "3ds": {
    "name": "Citra/Azahar (standalone) — adjust executable to whichever fork you have installed",
    "executable": "azahar",
    "argsTemplate": ["{romPath}"]
  },
  "gamecube": {
    "name": "Dolphin (standalone)",
    "executable": "dolphin-emu",
    "argsTemplate": ["-b", "-e", "{romPath}"]
  },
  "saturn": {
    "name": "RetroArch + Beetle Saturn",
    "executable": "retroarch",
    "argsTemplate": ["-L", "cores/mednafen_saturn_libretro.dll", "{romPath}"]
