# Komodo Core + Periphery config — template. Copy to `compose.env` (gitignored,
# same treatment as ../../credentials.md) and fill in real values there.
# Full reference: https://github.com/moghtech/komodo/blob/main/compose/compose.env
# (fetched 2026-09) — trimmed here to just what GameTorrent's single-VM setup needs.

COMPOSE_KOMODO_IMAGE_TAG=2
COMPOSE_KOMODO_BACKUPS_PATH=/etc/komodo/backups

## DB credentials — pick real values, don't leave these
KOMODO_DATABASE_USERNAME=changeme
KOMODO_DATABASE_PASSWORD=changeme

TZ=Etc/UTC

#=-------------------------=#
#= Komodo Core             =#
#=-------------------------=#

## Reachable at http://<kan2server-ip>:9120 once up
KOMODO_HOST=http://<vm-ip>:9120
KOMODO_TITLE=GameTorrent Ops

KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub

KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME=changeme
KOMODO_INIT_ADMIN_PASSWORD=changeme

## Server name Periphery connects as — the stacks.toml `server = "..."`
## field in cicd/gitops/stacks.toml must match this exactly.
KOMODO_FIRST_SERVER_NAME=kan2server

## Used to auth incoming git webhooks, if you set any up later (docs/GITOPS.md).
KOMODO_WEBHOOK_SECRET=changeme-random-string
## Used to sign session JWTs.
KOMODO_JWT_SECRET=changeme-random-string

#=-------------------------=#
#= Komodo Periphery        =#
#=-------------------------=#

PERIPHERY_CORE_ADDRESS=ws://core:9120
PERIPHERY_CONNECT_AS=${KOMODO_FIRST_SERVER_NAME}
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub

## GameTorrent's git clone (managed by the gametorrent-webui Stack) will
## live under here — must match the host path mounted into the periphery
## container in compose.yaml.
PERIPHERY_ROOT_DIRECTORY=/etc/komodo
